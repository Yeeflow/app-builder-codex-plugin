            "left": "{{ActivityParentBusinessField}}",
            "op": "0",
            "right": [
              {
                "type": "expr",
                "exprType": "list_field",
                "valueType": "input",
                "prop": "ListDataID",
                "id": "ListDataID",
                "name": "List Fields:Id"
              }
            ],
            "showCus": false,
            "pre": "and"
          }
        ],
        "sort": [
          {
            "SortName": "{{StartDateField}}",
